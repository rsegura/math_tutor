# Copy to .env and replace placeholders only for live voice runs.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_API_KEY=replace-me

# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini-2024-07-18
# LLM_BASE_URL=
# OpenRouter example (select a model with Responses API + tool calling):
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=replace-me
LLM_FIRST_RESPONSE_SECONDS=4
LLM_TOTAL_SECONDS=10
LLM_BASE_URL=https://openrouter.ai/api/v1

TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_turbo_v2_5
# Optional for ElevenLabs: empty delegates selection to the plugin default.
# Required when TTS_PROVIDER=openai.
TTS_VOICE_ID=
TTS_API_KEY=replace-me

DATABASE_PATH=/app/data/math_tutor.db
STORE_TRANSCRIPT=true
AUDIO_EVIDENCE_ENABLED=false
AUDIO_EVIDENCE_RETENTION_DAYS=7
AUDIO_EVIDENCE_CONTEXT_SECONDS=20
AUDIO_EVIDENCE_HARD_CAP_SECONDS=30
AUDIO_EVIDENCE_DIRECTORY=/app/data/evidence-clips
AUDIO_RETENTION_SWEEP_INTERVAL_SECONDS=300

# Server-only. Use a high-entropy value; never expose it to the learner client.
THERAPIST_API_ENABLED=true
THERAPIST_API_TOKEN=replace-with-a-random-server-secret
